{
  "name": "@enthus-appdev/llm-cli-setup",
  "version": "1.13.1",
  "description": "CLI tools setup with LLM integration - installs and configures sqlcmd, gh, atl, n8nctl, gcx, m365, esq, discordctl, playwright, and hcloud with Claude Code, Antigravity, and Codex support",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./installers": "./lib/installers/index.js",
    "./llm": "./lib/llm/index.js",
    "./utils": "./lib/utils/index.js"
  },
  "bin": {
    "llm-cli-setup": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "author": "enthus GmbH",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "bin",
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/enthus-appdev/llm-cli-setup.git"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "inquirer": "^14.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9"
  }
}
